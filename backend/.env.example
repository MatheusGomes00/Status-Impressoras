# ============================================================
# Modelo de configuração. Copie para ".env" e preencha com os
# valores reais do seu ambiente. Este arquivo (.env.example)
# PODE ser versionado no Git; o ".env" real NUNCA deve ser.
# ============================================================

# --- Banco de dados (MariaDB) ---
DB_HOST=host
DB_PORT=port
DB_USER=user
DB_PASSWORD=password
DB_NAME=name

# Pool de conexões assíncrono (aiomysql)
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- Coleta SNMP ---
SNMP_DEFAULT_COMMUNITY=public
SNMP_TIMEOUT_SECONDS=3
SNMP_RETRIES=1
SNMP_PORT=161

# Quantas impressoras consultar simultaneamente durante a coleta
COLLECTOR_MAX_CONCURRENT_REQUESTS=15

# Quantos pontos percentuais o nível precisa SUBIR entre duas leituras
# para ser considerado troca de cartucho. Abaixo disso, é oscilação
# normal da medição da impressora.
COLLECTOR_LIMIAR_TROCA_TONER_PP=20
