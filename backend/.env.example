# ============================================================
# Modelo de configuração. Copie para ".env" e preencha com os
# valores reais do seu ambiente. Este arquivo (.env.example)
# PODE ser versionado no Git; o ".env" real NUNCA deve ser.
# ============================================================

# --- Banco de dados (MariaDB) ---
DB_HOST=host
DB_PORT=port
DB_USER=user
DB_PASSWORD=password
DB_NAME=name

# Pool de conexões assíncrono (aiomysql)
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- Coleta SNMP ---
SNMP_DEFAULT_COMMUNITY=public
SNMP_TIMEOUT_SECONDS=3
SNMP_RETRIES=1
SNMP_PORT=161

# OID do contador de CÓPIAS (MIB privada do fabricante).
# A Printer-MIB padrão só expõe o total de páginas; cópias separadas
# só existem na MIB do fabricante e o OID varia por série.
# Descubra com: python descobrir_oids_canon.py --ip <IP> --apenas-numericos
# Vazio = não coletar cópias (leitura_toner.paginas_copias fica NULL).
SNMP_OID_CONTADOR_COPIAS=

# Quantas impressoras consultar simultaneamente durante a coleta
COLLECTOR_MAX_CONCURRENT_REQUESTS=15

# Quantos pontos percentuais o nível precisa SUBIR entre duas leituras
# para ser considerado troca de cartucho. Abaixo disso, é oscilação
# normal da medição da impressora.
COLLECTOR_LIMIAR_TROCA_TONER_PP=20

# Após quantos minutos uma coleta presa em RUNNING é dada como processo
# morto e encerrada como FAILED, liberando as coletas seguintes.
COLLECTOR_TIMEOUT_COLETA_MINUTOS=30

# --- Agendador ---
# Horários das coletas diárias (HH:MM separados por vírgula).
# Roda todos os dias da semana.
SCHEDULER_HORARIOS=09:00,13:00,17:00
SCHEDULER_TIMEZONE=America/Sao_Paulo
